# Copy to .env for local development. Never commit .env or real credentials.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/erp
MONGODB_DB_NAME=erp_dev
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12
# Reserved flags; they do not switch runtime functionality yet.
ENABLE_MULTI_COMPANY=false
ENABLE_BRANCHES=false
ENABLE_WAREHOUSES=false
ENABLE_MFA=false

# Frontend public variable: configure in apps/web/.env.local or Render static site.
# VITE_API_BASE_URL=https://erp-api-gateway.eduardoportillo138.workers.dev/api/v1
# SEED_ADMIN_EMAIL=admin@example.invalid
# SEED_ADMIN_PASSWORD=SET_ONLY_IN_LOCAL_ENV
