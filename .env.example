NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/erp_dev
MONGODB_DB_NAME=erp_dev
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12
# Configure the device-reachable backend URL in apps/web/.env.local or apps/mobile/.env.local
# VITE_API_BASE_URL=http://localhost:3000/api/v1
# SEED_ADMIN_EMAIL=admin@example.invalid
# SEED_ADMIN_PASSWORD=provide_locally_never_commit
