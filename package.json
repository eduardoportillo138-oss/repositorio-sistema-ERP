{
  "name": "erp-empresarial",
  "version": "0.1.0",
  "description": "ERP Empresarial Modular - Monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build -w backend && npm run build -w apps/web && npm run build -w apps/mobile",
    "dev": "npm run dev -w backend",
    "test": "jest",
    "test:mongodb": "jest --runInBand --testPathPattern=mongodb.integration",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "npm run test:e2e -w apps/web",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "backend:dev": "npm run dev -w backend",
    "backend:build": "npm run build -w backend",
    "backend:start": "npm run start -w backend",
    "mobile:android": "npm run android -w apps/mobile",
    "mobile:start": "npm run start -w apps/mobile",
    "mobile:ios": "npm run ios -w apps/mobile",
    "web:dev": "npm run dev -w apps/web",
    "web:build": "npm run build -w apps/web",
    "build:packages": "npm run build -w packages/types && npm run build -w packages/constants && npm run build -w packages/config && npm run build -w packages/validation && npm run build -w packages/api-client && npm run build -w packages/ui && npm run build -w packages/session",
    "test:client": "jest --runInBand --testPathPattern=api-client",
    "mobile:web": "npm run dev -w apps/mobile",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@react-native-community/cli": "12.3.7",
    "@react-native-community/cli-platform-android": "12.3.7",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.0.11",
    "image-size": "2.0.4",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "mongodb-memory-server": "^10.4.3",
    "patch-package": "^8.0.0",
    "prettier": "^3.2.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
